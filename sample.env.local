# Example local environment configuration

# Enable file watching for WSL/Windows mounted drives (optional)
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000

# Optional Google Analytics measurement ID (enables GA if set)
NEXT_PUBLIC_GA_ID=
# Optional HubSpot portal ID (numeric only, exclude the trailing .js)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
