# Example local environment configuration

# Enable file watching for WSL/Windows mounted drives (optional)
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000

# OpenAI API key for article enrichment (required for npm run article-enrichment)
# Obtain from https://platform.openai.com/ and paste here; do not commit real keys.
OPENAI_API_KEY=

# OpenAI model configuration (optional; defaults shown)
# Reasoning-capable model is recommended for best results
OPENAI_MODEL=gpt-5-mini
# Reasoning effort: low | medium | high
OPENAI_REASONING=medium

# Optional Google Analytics measurement ID (enables GA if set)
NEXT_PUBLIC_GA_ID=
# Optional HubSpot portal ID (numeric only, exclude the trailing .js)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
